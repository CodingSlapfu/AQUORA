+static uint32_t air_count, air_sum;
+
+unsigned plat_air_sample(unsigned *packets)
+{
+    unsigned n=air_count;
+    unsigned value=n?air_sum/n:0;
+    *packets=n;
+    air_count=air_sum=0;
+    return value;
