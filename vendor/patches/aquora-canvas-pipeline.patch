--- a/vendor/fm1-base/device/gfx.c
+++ b/vendor/fm1-base/device/gfx.c
@@ -19,7 +19,12 @@
 #define APP_CANVAS_PX (240u * 144u)   /* X0X: the main area, both bands, is 240 x 144 */
 #endif
 #define CV_MAX APP_CANVAS_PX      /* (app.h may give less: a WiFi build needs the pool; cv_begin keeps to it) */
+#if APP_CANVAS_DOUBLE_BUFFER
+static uint16_t cv_storage[2][CV_MAX] __attribute__((section(".pool")));
+static uint16_t *cv_px=cv_storage[0],*cv_last_sent;
+#else
 static uint16_t cv_px[CV_MAX] __attribute__((section(".pool")));
+#endif
 static uint32_t cv_w, cv_h;
 static int32_t cv_oy;            /* y offset for graph drawing */
 static int32_t cv_y0, cv_y1;     /* X0X: the rows drawing may touch (cv_band) */
@@ -65,7 +70,14 @@
     uint32_t i, n;
     if (w * h > CV_MAX)
         h = CV_MAX / w;
+#if APP_CANVAS_DOUBLE_BUFFER
+    /* Draw only into the buffer that the most recent blit cannot read.
+     * lcd_window still retires the previous DMA before starting a new one.
+     * Repeated begin without blit keeps the safe buffer rather than toggling. */
+    cv_px=cv_last_sent==cv_storage[0]?cv_storage[1]:cv_storage[0];
+#else
     lcd_sync();                     /* the last blit may still read cv_px */
+#endif
     cv_w = w;
     cv_h = h;
     cv_oy = cv_y0 = 0;
@@ -83,13 +95,23 @@
     cv_y1 = y0 + h;
 }
 
-static void cv_blit(uint32_t x, uint32_t y) { lcd_blit(x, y, cv_w, cv_h, cv_px); }
+static void cv_blit(uint32_t x, uint32_t y)
+{
+    lcd_blit(x,y,cv_w,cv_h,cv_px);
+#if APP_CANVAS_DOUBLE_BUFFER
+    if(cv_w&&cv_h)cv_last_sent=cv_px;
+#endif
+}
 
 /* canvas rows r0 .. cv_h-1 only, to screen row y + r0 */
 static void cv_blit_from(uint32_t x, uint32_t y, uint32_t r0)
 {
-    if (r0 < cv_h)
+    if (r0 < cv_h) {
         lcd_blit(x, y + r0, cv_w, cv_h - r0, cv_px + r0 * cv_w);
+#if APP_CANVAS_DOUBLE_BUFFER
+        if(cv_w)cv_last_sent=cv_px;
+#endif
+    }
 }
 
